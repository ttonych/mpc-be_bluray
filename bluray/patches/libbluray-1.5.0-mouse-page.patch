+int bd_mouse_select_page(BLURAY *bd, int64_t pts, uint16_t x, uint16_t y)
+{
+    int result = 0;
+    unsigned i;
+    bd_mutex_lock(&bd->mutex);
+    _set_scr(bd, pts);
+    /* Conservative: do not infer a navigation route across masked input. */
+    for (i = UO_MASK_MOVE_UP_SELECTED_BUTTON_MASK_INDEX; i <= UO_MASK_SELECT_AND_ACTIVATE_MASK_INDEX; ++i) {
+        if (_is_uo_masked(bd, (bd_uo_mask_index_e)i)) goto done;
+    }
+    if (bd->title_type == title_hdmv && bd->hdmv_suspended) {
+        result = _run_gc(bd, GC_CTRL_MOUSE_PAGE, ((uint32_t)x << 16) | y);
+    }
+done:
+    bd_mutex_unlock(&bd->mutex);
+    return result;
+}
